":0.0,"Bindings":{"Visible":{"Formula":{"Expression":"[TruckSimulatorPlugin.Job.InProgress] and\r\n[GameRawData.JobValues.Market] != 'external_contracts'"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"0Arame Mono","FontWeight":"Bold","FontSize":25.0,"Text":"External Contract","TextColor":"#FF00FFFF","HorizontalAlignment":0,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":660.0,"Top":500.0,"Visible":false,"BlinkPhasisInverted":false,"Width":300.0,"Name":"ExternalContract","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Visible":{"Formula":{"Expression":"[GameRawData.JobValues.Market] = 'external_contracts'"},"Mode":2}}}],"Visible":true,"BlinkPhasisInverted":false,"Name":"JRT","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.Layer, SimHub.Plugins","Group":true,"Repetitions":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"0Arame Mono","FontSize":25.0,"Text":"00:00:00","TextColor":"#FFFFFFFF","HorizontalAlignment":0,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":410.0,"Top":500.0,"Visible":true,"BlinkPhasisInverted":false,"Width":250.0,"Name":"Value","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"FormatString":"","Formula":{"JSExt":0,"Interpreter":1,"Expression":"let navTime = $prop('DataCorePlugin.GameRawData.NavigationValues.NavigationTime')\r\nlet totalMinutes = navTime.TotalMinutes;\r\nlet outText = '';\r\nlet days = Math.floor(totalMinutes / 1440);\r\nif (days > 0) { outText += days + ' day' + (days > 1 ? 's ' : ' '); }\r\noutText += format(navTime, 'hh\\\\:mm')\r\nreturn outText;"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"0Arame Mono","FontWeight":"Bold","FontSize":25.0,"Text":"ETA","TextColor":"#FF00FFFF","HorizontalAlignment":0,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":360.0,"Top":500.0,"Visible":true,"BlinkPhasisInverted":false,"Width":50.0,"Name":"Label","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0}],"Visible":true,"BlinkPhasisInverted":false,"Name":"ETA","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.Layer, SimHub.Plugins","Group":true,"Repetitions":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"0Arame Mono","FontSize":25.0,"Text":"50 Mins","TextColor":"#FFFFFFFF","HorizontalAlignment":0,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":110.0,"Top":500.0,"Visible":true,"BlinkPhasisInverted":false,"Width":250.0,"Name":"Value","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"let navTime = $prop('DataCorePlugin.GameRawData.Job.NavigationTime');\r\nif (!navTime || isNaN(navTime.TotalMinutes)) return '--';\r\n\r\nlet rtr = $prop('variable.RTR') === 1;\r\n\r\n// Game time runs faster than real time by the map scale (EU ~19, UK ~15).\r\n// Cities run at ~1:3, so only remember open-road scales: the route is mostly road.\r\nlet scale = $prop('DataCorePlugin.GameRawData.CommonValues.Scale');\r\nif (scale >= 10 && scale <= 25) root['roadScale'] = scale;\r\nlet roadScale = root['roadScale'] || 19;\r\n\r\nlet divisor = rtr ? roadScale : 6;\r\n\r\n// Calculate scaled total minutes, then extract hours and remaining minutes\r\nlet scaledMinutes = Math.trunc(navTime.TotalMinutes / divisor);\r\nlet hours = Math.trunc(scaledMinutes / 60);\r\nlet mins  = scaledMinutes % 60;\r\n\r\n// Format output: omit hours if 0\r\nreturn hours > 0 ? `${hours}h ${mins}m` : `${mins}m`;"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"0Arame Mono","FontWeight":"Bold","FontSize":25.0,"Text":"RTR","TextColor":"#FF00FFFF","HorizontalAlignment":0,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":60.0,"Top":500.0,"Visible":true,"BlinkPhasisInverted":false,"Width":50.0,"Name":"Label","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0}],"Visible":true,"BlinkPhasisInverted":false,"Name":"RTR","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.Layer, SimHub.Plugins","Group":true,"Repetitions":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.ImageItem, SimHub.Plugins","Image":"icon-income","AutoSize":false,"BackgroundColor":"#00FFFFFF","Height":32.0,"Left":764.0,"Top":464.0,"Visible":true,"BlinkPhasisInverted":false,"Width":32.0,"Name":"Icon","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Alte DIN 1451 Mittelschrift","FontSize":25.0,"Text":"104,365","TextColor":"#FFFFFF00","HorizontalAlignment":0,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":800.0,"Top":460.0,"Visible":true,"BlinkPhasisInverted":false,"Width":160.0,"Name":"Value","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"FormatString":"#,#","Formula":{"Expression":"[GameRawData.JobValues.Income]"},"Mode":2}}}],"Visible":true,"BlinkPhasisInverted":false,"Name":"Income","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.Layer, SimHub.Plugins","Group":true,"Repetitions":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.ImageItem, SimHub.Plugins","Image":"icon-weight","AutoSize":false,"BackgroundColor":"#00FFFFFF","Height":32.0,"Left":564.0,"Top":464.0,"Visible":true,"BlinkPhasisInverted":false,"Width":32.0,"Name":"Icon","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0},{"$type":"SimHub.Plugins.OutputPlu