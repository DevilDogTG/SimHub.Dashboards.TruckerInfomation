ues.ForwardGearCount');\r\n\r\nconst totalCrawler = totalFwd == 13 ? 1 : (totalFwd == 14 ? 2 : 0);\r\nif (gear <= totalCrawler) { return 'C' + gear; }\r\n\r\nif (gear >= 10) {\r\n  const gearRatio =  $prop('DataCorePlugin.GameRawData.TruckValues.ConstantsValues.MotorValues.GearRatiosForward' + gear)\r\n  \r\n  if (gearRatio == 1) { return 'DD'; }\r\n  else if (gearRatio < 1) { return 'OD'; }\r\n}\r\n\r\nreturn gear - totalCrawler;"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.Layer, SimHub.Plugins","Group":true,"Repetitions":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.ImageItem, SimHub.Plugins","Image":"gearbox-automatic","AutoSize":false,"BackgroundColor":"#00FFFFFF","Height":30.0,"Left":815.0,"Top":345.0,"Visible":true,"BlinkPhasisInverted":false,"Width":30.0,"Name":"Automatic","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Visible":{"Formula":{"Expression":"[GameRawData.TruckValues.ConstantsValues.MotorValues.ShifterTypeValue] = 'Automatic' or\r\n[GameRawData.TruckValues.ConstantsValues.MotorValues.ShifterTypeValue] = 'Arcade'"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.ImageItem, SimHub.Plugins","Image":"gearbox-sequential","AutoSize":false,"BackgroundColor":"#00FFFFFF","Height":30.0,"Left":815.0,"Top":345.0,"Visible":false,"BlinkPhasisInverted":false,"Width":30.0,"Name":"Sequencetial","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Visible":{"Formula":{"Expression":"[GameRawData.TruckValues.ConstantsValues.MotorValues.ShifterTypeValue] = 'Manual'"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.ImageItem, SimHub.Plugins","Image":"gearbox-hshifter","AutoSize":false,"BackgroundColor":"#00FFFFFF","Height":30.0,"Left":815.0,"Top":345.0,"Visible":false,"BlinkPhasisInverted":false,"Width":30.0,"Name":"Manual","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Visible":{"Formula":{"Expression":"[GameRawData.TruckValu