Amount])) or\r\nisincreasing (5000 ,([DataCorePlugin.GameRawData.SpecialEventsValues.Fined]))"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Orbitron","FontSize":40.0,"Text":"-€500","TextColor":"#FFFFFFFF","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":60.0,"Top":460.0,"Visible":true,"BlinkPhasisInverted":false,"Width":900.0,"Name":"Amount","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Visible":{"Formula":{"Expression":"isincreasing (5000 ,([DataCorePlugin.GameRawData.GamePlay.FinedEvent.Amount])) or\r\nisincreasing (5000 ,([DataCorePlugin.GameRawData.SpecialEventsValues.Fined]))"},"Mode":2},"Text":{"FormatString":"-€0","Formula":{"Expression":"[GameRawData.GamePlay.FinedEvent.Amount]"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Orbitron","FontSize":50.0,"Text":"Traffic Violation","TextColor":"#FFFFFFFF","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":80.0,"Left":60.0,"Top":380.0,"Visible":true,"BlinkPhasisInverted":false,"Width":900.0,"Name":"Description","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Visible":{"Formula":{"Expression":"isincreasing (5000 ,([DataCorePlugin.GameRawData.GamePlay.FinedEvent.Amount])) or\r\nisincreasing (5000 ,([DataCorePlugin.GameRawData.SpecialEventsValues.Fined]))"},"Mode":2},"Text":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"var currentOffence = $prop('GameRawData.GameplayEvents.Fined.Offence');\r\nvar cleanOffence = \"Traffic violation\";\r\nvar speed = $prop('DataCorePlugin.GameRawData.TruckValues.CurrentValues.DashboardValues.Speed.Kph');\r\nvar limit = $prop('DataCorePlugin.GameRawData.NavigationValues.SpeedLimit.Kph');\r\nswitch(String(currentOffence).toLowerCase()) {\r\n  case \"speeding\":\r\n    cleanOffence = \"Speeding\" + \"[+\" + (speed - limit) + \"km]\";\r\n    break;\r\n  case \"speeding_camera\":\r\n    cleanOffence = \"Speeding (Camera)\" + \"[+\" + (speed - limit) + \"km]\";\r\n    break;\r\n  case \"crash\":\r\n    cleanOffence = \"Colliding with another vehicle\";\r\n    break;\r\n  case \"wrong_way\":\r\n    cleanOffence = \"Wrong way violation\";\r\n    break;\r\n  case \"red_signal\":\r\n    cleanOffence = \"Passing traffic lights\";\r\n    break;\r\n  case \"no_lights\":\r\n    cleanOffence = \"Not using headlights\";\r\n    break;\r\n  case \"avoid_sleeping\":\r\n    cleanOffence = \"Fatigue violation\";\r\n    break;\r\n  case \"avoid_weighing\":\r\n    cleanOffence = \"Weighing station bypass\";\r\n    break;\r\n  case \"avoid_inspection\":\r\n    cleanOffence = \"Inspection bypass violation\";\r\n    break;\r\n  case \"illegal_trailer\":\r\n    cleanOffence = \"Illegal trailer fine\";\r\n    break;\r\n  case \"hard_shoulder_violation\":\r\n    cleanOffence = \"Shoulder driving\";\r\n    break;\r\n}\r\nreturn cleanOffence"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Orbitron","FontSize":34.0,"Text":"Fined","TextColor":"#FF000000","HorizontalAlignment":1,"VerticalAlignment":1,"Rotation":270.0,"BackgroundColor":"#FFFFFFFF","BorderStyle":{"BorderBottom":1,"BorderLeft":1},"Height":50.0,"Left":-35.0,"Top":415.0,"Visible":true,"BlinkPhasisInverted":false,"Width":120.0,"Name":"Header","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"BackgroundColor":{"Formula":{"Expression":"isincreasing (5000 ,([DataCorePlugin.GameRawData.GamePlay.FinedEvent.Amount])) or\r\nisincreasing (5000 ,([DataCorePlugin.GameRawData.SpecialEventsValues.Fined]))"},"Mode":2}}}],"Visible":false,"BlinkPhasisInverted":false,"Name":"Fined Event","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Visible":{"Formula":{"Expression":"isincreasing (5000 ,([DataCorePlugin.GameRawData.GamePlay.FinedEvent.Amount])) or\r\nisincreasing (5000 ,([DataCorePlugin.GameRawData.SpecialEventsValues.Fined]))"},"Mode":2}}}],"Visible":true,"BlinkPhasisInverted":false,"Name":"Panel Information","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.Layer, SimHub.Plugins","Group":true,"Repetitions":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.Layer, SimHub.Plugins","Group":true,"Repetitions":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"0Arame Mono","FontWeight":"SemiBold","FontSize":20.0,"Text":"93.5%","TextColor":"#FFFFFFFF","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","BorderStyle":{"BorderTop":1,"BorderLeft":1},"Height":30.0,"Left":780.0,"Top":120.0,"Visible":true,"BlinkPhasisInverted":false,"Width":70.0,"Name":"Percent","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"FormatString":"0.0'%'","Formula":{"Expression":"[DataCorePlugin.GameData.FuelPercent]"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"0Arame Mono","FontWeight":"SemiBold","FontSize":20.0,"Text":"935","TextColor":"#FFFFFFFF","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","BorderStyle":{"BorderTop":1},"Height":30.0,"Left":710.0,"Top":120.0,"Visible":true,"BlinkPhasisInverted":false,"Width":70.0,"Name":"Remain","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"FormatString":"#,#","Formula":{"Expression":"[DataCorePlugin.GameRawData.TruckValues.CurrentValues.DashboardValues.FuelValue.Amount]"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Alte DIN 1451 Mittelschrift","FontSize":24.0,"Text":"1.84","TextColor":"#FFFFFFFF","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":30.0,"Left":780.0,"Top"